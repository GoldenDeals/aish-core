{
    import ./system.Agentfile

    llm anthropic model claude-sonnet-5-5
    description "Main general-purpuse agent"

    tool {
        fs_read
        fs_edit root .
        bash

        mcp exa url https://mcp.exa.ai/mcp?exaApiKey={$EXA_API_KEY}
    }
}

reviewer {
    import ./system.Agentfile

    context system_prompt examples/prompts/reviewer.md
    description "Reads files and reports problems; never edits"
    llm anthropic model claude-haiku-5-5
    tool fs_read
}

researcher clean {
    import ./system.Agentfile

    context system_prompt examples/prompts/researcher.md
    description "Searches the web and the repository for facts; never edits"
    max_steps 30
    llm anthropic model claude-haiku-5-5
    tool {
        fs_read
        mcp exa url https://mcp.exa.ai/mcp?exaApiKey={$EXA_API_KEY}
    }
}

coder {
    import ./system.Agentfile

    context system_prompt examples/prompts/coder.md
    description "Implements a well-defined change and runs the tests"
    max_steps 100
    llm anthropic model claude-opus-5-5 max_tokens 32000
}

tester clean {
    import ./system.Agentfile

    context system_prompt examples/prompts/tester.md
    description "Runs the tests and reports what fails; never edits"
    max_depth 0
    tool fs_read bash
}

summarizer clean {
    import ./system.Agentfile

    context system_prompt examples/prompts/summarizer.md
    inject off
    description "Condenses long text"
    max_steps 5
    llm anthropic model claude-haiku-5-5 max_tokens 2000
}
