(files) {
    tool fs_read
    tool fs_edit {
        root .
    }
}

main {
    max_steps 50
    agent loop
    context system_prompt
    context agents_md AGENTS.md {
        home
        # walk
        local
    }

    frontend cli

    llm anthropic {
        model claude-haiku-5-5
        api_key {$ANTHROPIC_API_KEY}
        base_url http://127.0.0.1:8317
    }

    import files
    tool bash

    policy cedar ./examples/policies/allow-all.cedar
    context skills ./.agents/skills ./examples/skills

    tool mcp exa {
        url https://mcp.exa.ai/mcp?exaApiKey={$EXA_API_KEY}
    }

    store jsonl .agents/sessions
}
