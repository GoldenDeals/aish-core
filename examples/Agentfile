(system) {
    max_steps 50    
    max_depth 2
    agent loop

    log {
        file .agents/logs/%D/%T-%s.log level debug rotate 24h
        trace .agents/traces/%D/%H-%s.trace rotate 1h
    }

    llm anthropic {
        api_key "{$ANTHROPIC_API_KEY}"
        max_tokens 64000
        base_url http://127.0.0.1:8317
    }

    context {
        system_prompt
        agents_md AGENTS.md home local pattern CLAUDE.md
        skills ./.agents/skills ./examples/skills
    }

    subagents core communication

    policy cedar ./examples/policies/allow-all.cedar
    store jsonl .agents/sessions rotate 24h

    frontend cli
}

{
    import system
    llm anthropic model claude-sonnet-5-5
    description "Main general-purpuse agent"

    tool {
        fs_read
        fs_edit root .
        bash

        mcp exa url https://mcp.exa.ai/mcp?exaApiKey={$EXA_API_KEY}
    }
}

reviewer clean {
    description "Reads files and reports problems; never edits"
    max_depth 1
    agent loop
    context system_prompt
    llm anthropic {
        model claude-haiku-5-5
        api_key "{$ANTHROPIC_API_KEY}"
        base_url http://127.0.0.1:8317
    }
    tool fs_read
    subagents communication
    policy cedar ./examples/policies/allow-all.cedar
}
