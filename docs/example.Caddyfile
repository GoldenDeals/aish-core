# Пример конфигурации MVP.
#
#   aish --config docs/example.Caddyfile                 # новая сессия
#   aish --config docs/example.Caddyfile --resume <ID>   # продолжить сессию
#   aish --config docs/example.Caddyfile --trace t.log   # trace каждой транзакции пишется в t.log сразу после коммита
#
# Поддерживается один блок агента: main. Директива «<namespace> <name> [args] { ... }»
# подключает модуль <namespace>.<name>; список модулей сборки выводит `aish list-modules`.
# Секреты задаются только через {$ENV}.

# Сниппет: подключается строкой «import files».
(files) {
    tool fs_read
    tool fs_edit {
        root .
    }
}

main {
    # Шагов агента (запросов к модели) на одно сообщение пользователя.
    max_steps 50

    agent loop

    # Системный промпт: без аргументов встроенный; иначе «context system_prompt файл.md»
    # или блок { text "..." }.
    context system_prompt
    frontend cli

    # Ключ можно не указывать: SDK читает ANTHROPIC_API_KEY или профиль `ant auth login`.
    llm anthropic {
        model claude-opus-5-5
        api_key {$ANTHROPIC_API_KEY}
        base_url http://127.0.0.1:8317
    }

    import files
    tool bash

    # Запись, кроме чтения, подтверждается пользователем.
    policy ask

    # Журнал сессий; по умолчанию ~/.aish/sessions.
    store jsonl ~/.aish/sessions
}
